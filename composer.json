{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ayjed/sitepulse",
    "type": "project",
    "description": "Lightweight, self-hosted website uptime and response-time monitoring.",
    "keywords": ["laravel", "framework", "monitoring", "uptime", "sitepulse"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^12.5"
    },
    "conflict": {
        "symfony/clock": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/css-selector": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/mailer": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/translation": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/var-dumper": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install --no-interaction",
            "@php -r \"require 'vendor/autoload.php'; exit(\\App\\Support\\EnvironmentSetup::prepare(getcwd() ?: '.'));\"",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"require 'vendor/autoload.php'; exit(\\App\\Support\\EnvironmentSetup::prepare(getcwd() ?: '.'));\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
